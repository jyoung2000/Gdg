# Meridian configuration. Copy to .env and fill in what you need.
# Everything here is optional: Meridian starts with no configuration at all and
# reports each provider as "not configured" until it has a credential.

# --- Core -------------------------------------------------------------------
MERIDIAN_PORT=4639
MERIDIAN_LOG_LEVEL=info
MERIDIAN_LOG_FORMAT=json

# Encrypts stored credentials. Generate with:
#   openssl rand -base64 32
# Without it, a key is generated into the database — fine for a laptop, not for
# a shared or exposed instance.
MERIDIAN_MASTER_KEY=

# --- Access -----------------------------------------------------------------
# Require an API key on /v1, /anthropic and /api. Leave false for a single-user
# install on a trusted network; turn it on for anything reachable by others.
MERIDIAN_AUTH_REQUIRED=false
MERIDIAN_ADMIN_EMAIL=
MERIDIAN_ADMIN_PASSWORD=

# --- Economics --------------------------------------------------------------
# Master switch for paid routing. While false, no request can reach a model that
# can charge money, whatever the request asks for.
MERIDIAN_ALLOW_PAID=false
MERIDIAN_ROUTING_MODE=AUTO
# STRICT_LOCAL | TRUSTED_ONLY | FREE_PROVIDERS | ANY_PROVIDER
MERIDIAN_PRIVACY_MODE=TRUSTED_ONLY

# --- Sandbox ----------------------------------------------------------------
# docker | process | disabled
MERIDIAN_SANDBOX=docker
MERIDIAN_SANDBOX_IMAGE=meridian-sandbox:latest

# Where the workspace directory lives on the Docker host.
#
# Only needed when the gateway itself runs in a container AND the sandbox is
# "docker". The gateway starts sandbox containers through the host's daemon,
# which resolves the mount against the host filesystem rather than the
# gateway's — so without this it mounts an empty directory and every command
# runs against nothing. Setting it also switches Compose's workspace mount from
# a named volume to this directory.
#
# Create it before starting, owned by the uid the gateway runs as (1001 in the
# shipped image):
#   mkdir -p /srv/meridian/workspaces && chown 1001:1001 /srv/meridian/workspaces
# MERIDIAN_WORKSPACE_HOST_ROOT=/srv/meridian/workspaces

MERIDIAN_SANDBOX_MEMORY_MB=2048
MERIDIAN_SANDBOX_CPUS=2
MERIDIAN_SANDBOX_TIMEOUT_MS=120000
# Also gates the agents' web_fetch tool. Off means no outbound network from
# anything a model can start.
MERIDIAN_SANDBOX_NETWORK=false

# --- Local inference --------------------------------------------------------
# Endpoint overrides for a self-hosted server that is not on the default port.
# These are URLs, not credentials: they are never stored or sent as a key.
# OLLAMA_HOST=localhost:11434
# VLLM_BASE_URL=http://localhost:8000/v1
# LLAMACPP_BASE_URL=http://localhost:8080/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
MERIDIAN_LOCAL_ENDPOINTS=http://host.docker.internal:11434,http://host.docker.internal:8000,http://host.docker.internal:1234

# --- Provider credentials ---------------------------------------------------
# Aggregator (one key, many models — the easiest way to start)
OPENROUTER_API_KEY=

# Fast inference
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=

# Open-weight hosts
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
HYPERBOLIC_API_KEY=
NVIDIA_API_KEY=

# First-party
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=

# Media
HF_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
FAL_KEY=
REPLICATE_API_TOKEN=
AI_HORDE_API_KEY=
