{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Meridian",
  "version": "1.0.0",
  "identifier": "ai.meridian.desktop",
  "mainBinaryName": "meridian",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Meridian",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "dragDropEnabled": false,
        "visible": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "tooltip": "Meridian",
      "showMenuOnLeftClick": false
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "Meridian",
    "category": "DeveloperTool",
    "shortDescription": "One interface for every model, provider and modality",
    "longDescription": "Meridian routes work to the right AI model across every provider you have, explains why it chose what it chose, and keeps your credentials encrypted on your own machine.",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../payload/runtime": "runtime/",
      "../payload/server": "server/",
      "../payload/payload.json": "payload.json"
    },
    "windows": {
      "signCommand": "node scripts/sign-windows.mjs %1",
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Meridian",
        "compression": "lzma",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
