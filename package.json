{
  "name": "meridian",
  "version": "1.0.0",
  "private": true,
  "description": "Meridian \u2014 Universal AI Gateway. One interface for every model, provider and modality.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop": "node scripts/build.mjs && node scripts/fetch-node-runtime.mjs && node scripts/package-desktop.mjs && node scripts/verify-desktop-payload.mjs",
    "build:offline-ui": "node scripts/build-offline-ui.mjs",
    "build:windows": "node scripts/build.mjs && node scripts/fetch-node-runtime.mjs --platform win32 --arch x64 && node scripts/package-desktop.mjs --platform win32 --arch x64 && node scripts/verify-desktop-payload.mjs",
    "check:deps": "node scripts/check-dependencies.mjs",
    "check:version": "node scripts/check-version.mjs",
    "desktop:dev": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:icon": "node scripts/make-desktop-icon.mjs",
    "desktop:payload": "node scripts/package-desktop.mjs",
    "desktop:runtime": "node scripts/fetch-node-runtime.mjs",
    "desktop:verify": "node scripts/verify-desktop-payload.mjs",
    "dev": "node scripts/dev.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "package:portable": "node scripts/package-portable.mjs",
    "package:windows": "pnpm build:windows && tauri build --config apps/desktop/src-tauri/tauri.conf.json",
    "sandbox:image": "node scripts/build-sandbox-image.mjs",
    "scorecard": "node scripts/scorecard.mjs",
    "start": "node dist/gateway/main.js",
    "test": "node scripts/test.mjs all",
    "test:chaos": "node scripts/test.mjs chaos",
    "test:contract": "node scripts/test.mjs contract",
    "test:e2e": "node scripts/test.mjs e2e",
    "test:integration": "node scripts/test.mjs integration",
    "test:live": "node scripts/test-live.mjs",
    "test:router": "node scripts/test.mjs router",
    "test:ui": "node scripts/test.mjs ui",
    "test:unit": "node scripts/test.mjs unit",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "uag": "node dist/cli/uag.js",
    "verify:providers": "node dist/cli/uag.js verify",
    "verify:release": "node scripts/verify-release.mjs --out docs/evidence/RELEASE.md"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
