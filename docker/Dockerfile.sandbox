# The image agent-authored commands run inside.
#
# It carries the toolchains a code task actually needs and nothing else: no
# shell utilities for reaching the network, no credentials, no package caches
# from the build. The container it runs in is created with no network, a
# read-only root filesystem and dropped capabilities — see DockerSandbox.
# Overridable for the same reason as the gateway image — see docker/Dockerfile.
ARG SANDBOX_BASE_IMAGE=node:22-bookworm-slim
FROM ${SANDBOX_BASE_IMAGE}

# The toolchain a code task actually needs. Installed only where the base does
# not already provide it, then verified: a sandbox missing its toolchain should
# fail to build rather than fail on the first command an agent runs.
RUN set -eu; \
    missing=''; \
    for tool in git python3 make g++ curl; do command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"; done; \
    if [ -n "$missing" ]; then \
      apt-get update \
      && apt-get install -y --no-install-recommends $missing ca-certificates python3-pip python3-venv \
      && rm -rf /var/lib/apt/lists/*; \
    fi; \
    for tool in git python3 make g++; do \
      command -v "$tool" >/dev/null 2>&1 || { echo "sandbox toolchain incomplete: $tool" >&2; exit 1; }; \
    done

RUN corepack enable && (corepack prepare pnpm@latest --activate || echo "pnpm not activated; the base image's package manager stands" >&2)

# A non-root default user, so a command cannot write outside the mounted
# workspace even if the isolation is later relaxed.
#
# At run time DockerSandbox overrides this with the gateway's own uid and gid.
# It has to: files in the workspace belong to whoever runs the gateway, and a
# container user with a different uid can read them but never write, which
# breaks every command that installs, builds or commits. Matching the caller
# grants exactly the access the gateway already has — the container is held in
# by having no network, no capabilities, a read-only root and nothing mounted
# but the workspace, not by its uid.
RUN (getent group runner || groupadd --system --gid 1002 runner) \
 && (getent passwd runner || useradd --system --uid 1002 --gid runner --home /home/runner --create-home runner)
USER runner
WORKDIR /work

CMD ["sh"]
